{
  "name": "shellx-cut-ui",
  "private": true,
  "version": "0.6.113",
  "type": "module",
  "description": "ShellX Cut UI — Vite + React + TS app shell (UI contract). The UI is an API client, nothing more: all state via verbs/WS, zero local mutation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ../scripts/check-ui-dist-identity.mjs --write --root ..",
    "check:dist-identity": "node ../scripts/check-ui-dist-identity.mjs --check --root ..",
    "preview": "vite preview",
    "test:lib": "node public-tests/lib/runLibraryTests.mjs",
    "test:feature-surface-contract": "tsx public-tests/feature-surface-contract.test.ts",
    "test:stock-provider-catalog": "tsx public-tests/stock-provider-catalog.test.ts",
    "test:source-navigation": "tsx public-tests/source-navigation.test.ts",
    "test:media-intelligence": "tsx public-tests/media-intelligence-search.test.ts",
    "test:manual-frontend-contract": "tsx public-tests/manual-frontend-contract.test.ts && tsx public-tests/manual-local-deeplink.test.ts",
    "test:manual-local-deeplink-browser": "node --test public-tests/manual-local-deeplink-browser.test.mjs",
    "test:startup-readiness": "tsx public-tests/startup-readiness.test.ts",
    "test:package-command-contract": "node public-tests/package-command-contract.test.mjs",
    "verify-generated-lifecycle": "node public-tests/verify-generated-asset-lifecycle.mjs",
    "verify-publish-package": "node public-tests/verify-publish-package.mjs",
    "verify-layout-contract": "node public-tests/layout-contract-verify.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "@puppeteer/browsers": "3.0.4",
    "@wdio/native-utils": "2.5.0",
    "deepmerge-ts": "8.0.1",
    "js-yaml": "4.3.1",
    "postcss": "8.5.24",
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-service": "^1.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "webdriverio": "^9.30.0"
  }
}
