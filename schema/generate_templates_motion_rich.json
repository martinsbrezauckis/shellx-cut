      "tags": ["motion", "presenter", "green-screen", "chroma-key", "composite", "promo", "rendered-media"],
      "params": {
        "eyebrow": {
          "type": "string",
          "default": "CREATOR MODE",
          "description": "Short campaign overline"
        },
        "title": {
          "type": "string",
          "required": true,
          "description": "Main presenter-promo headline"
        },
        "subtitle": {
          "type": "string",
          "default": "A cleaned, spill-suppressed subject inside a moving branded scene.",
          "description": "Supporting campaign copy"
        },
        "badge": {
          "type": "string",
          "default": "LOCAL COMPOSITE",
          "description": "Short end-frame badge"
        },
        "spillSuppression": {
          "type": "number",
          "default": 0.72,
