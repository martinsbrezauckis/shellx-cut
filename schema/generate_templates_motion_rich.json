          "description": "Green spill cleanup strength"
        },
        "accentColor": {
          "type": "color",
          "default": "#C084FC",
          "description": "Composite accent"
        },
        "duration_ms": {
          "type": "integer",
          "default": 6000,
          "minimum": 4000,
          "maximum": 12000,
          "step": 100,
          "description": "Rendered Motion clip duration"
        }
      },
      "defaults": { "duration_ms": 6000, "engine": "shellx-motion", "family": "keyed-subject-promo" },
      "capabilities": ["preview", "insert", "rendered_media", "motion_template", "chroma_key", "matte_cleanup", "quality_manifest", "text_fit", "safe_area"],
      "lowering": {
        "verb": "motion.template_to_cut",
        "args": {
          "template": "keyed-subject-promo",
          "params": {
            "eyebrow": "{{eyebrow}}",
            "title": "{{title}}",
            "subtitle": "{{subtitle}}",
            "badge": "{{badge}}",
            "spillSuppression": "{{spillSuppression}}",
            "accentColor": "{{accentColor}}"
          },
          "duration_ms": "{{duration_ms}}",
          "checkpoint": false
        }
      },
      "verification": {
        "expects": ["motion_receipt", "quality_manifest", "keying_evidence", "rendered_media", "asset_imported", "clip_created", "frame_changed", "text_fit"]
      }
    },
    {
      "id": "builtin.motion.tracked-callout-overlay",
      "source": "builtin",
      "kind": "motion",
      "title": "Tracked callout overlay",
      "summary": "Product annotation whose ring, leader, panel, and copy follow one synchronized baked tracking path.",
      "tags": ["motion", "tracked-callout", "annotation", "product-demo", "inspection", "overlay", "rendered-media"],
      "params": {
        "title": {
          "type": "string",
          "required": true,
          "description": "Main product-demo headline"
        },
        "subtitle": {
          "type": "string",
          "default": "A baked path keeps the annotation connected while the product frame moves.",
          "description": "Supporting product-demo copy"
        },
        "calloutTitle": {
          "type": "string",
          "default": "Adaptive cooling core",
          "description": "Tracked callout heading"
        },
        "calloutDetail": {
          "type": "string",
          "default": "Thermal load drops 18% under sustained local rendering.",
          "description": "Tracked callout detail"
        },
        "accentColor": {
          "type": "color",
          "default": "#22D3EE",
          "description": "Callout ring, leader, and panel accent"
        },
        "duration_ms": {
          "type": "integer",
          "default": 6000,
          "minimum": 4000,
          "maximum": 12000,
          "step": 100,
          "description": "Rendered Motion clip duration"
        }
      },
      "defaults": { "duration_ms": 6000, "engine": "shellx-motion", "family": "tracked-callout-overlay" },
      "capabilities": ["preview", "insert", "rendered_media", "motion_template", "tracked_callout", "quality_manifest", "text_fit", "safe_area"],
      "lowering": {
        "verb": "motion.template_to_cut",
        "args": {
          "template": "tracked-callout-overlay",
          "params": {
            "title": "{{title}}",
            "subtitle": "{{subtitle}}",
            "calloutTitle": "{{calloutTitle}}",
            "calloutDetail": "{{calloutDetail}}",
            "accentColor": "{{accentColor}}"
          },
          "duration_ms": "{{duration_ms}}",
          "checkpoint": false
        }
      },
      "verification": {
        "expects": ["motion_receipt", "quality_manifest", "rendered_media", "asset_imported", "clip_created", "frame_changed", "text_fit"]
      }
    }
  ]
}
