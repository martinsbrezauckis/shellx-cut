        },
        "dispatch": "library_folder_remove",
        "project_state": "none",
        "idempotency": "request_key",
        "replayability": "replayable",
        "async_job": "none",
        "ui_exposure": "human",
        "agent_chat": "deny",
        "risk": "destructive",
        "facets": []
      }
    }
  ]
}
