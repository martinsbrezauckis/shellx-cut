      "behavior": {
        "mutation_class": "asset_metadata",
        "side_effects": {
          "filesystem": true,
          "process": false,
          "network": false,
          "ui": false
        },
        "dispatch": "library_folder_add",
        "project_state": "none",
        "idempotency": "request_key",
        "replayability": "replayable",
        "async_job": "none",
        "ui_exposure": "human",
        "agent_chat": "deny",
        "risk": "reversible",
        "facets": []
      }
    },
    {
      "name": "library.folder_rename",
      "domain": "library",
      "description": "Rename a library folder and re-point every item filed under it. renamed:false if old is unknown or new is empty/taken. Returns {renamed, folders}.",
      "args": {
