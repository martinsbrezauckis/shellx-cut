        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "result": "{removed: bool, folders: [string]}",
      "behavior": {
        "mutation_class": "asset_metadata",
        "side_effects": {
          "filesystem": true,
          "process": false,
          "network": false,
